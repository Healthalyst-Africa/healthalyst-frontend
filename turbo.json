{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env*"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_HEALTHALYST_ORGANIZATION_APP_URL",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY"
  ],
  "globalPassThroughEnv": [
    "HEALTHALYST_PLATFORM_API_URL",
    "HEALTHALYST_APP_ORIGIN",
    "HEALTHALYST_PLATFORM_SESSION_REDIS_URL",
    "HEALTHALYST_PLATFORM_SESSION_SECRET",
    "HEALTHALYST_PLATFORM_REFRESH_COOKIE_NAME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", "vitest.config.ts"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": ["^test:coverage"],
      "outputs": ["coverage/**"]
    }
  }
}

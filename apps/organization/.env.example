# HealthAlyst Platform API: every screen follows its documented contract.
# Point this at any backend that implements that contract (the NestJS
# Platform API, or the Java backend once it is refactored to match).
# The browser calls it directly; it must allow this site's origin (CORS).
NEXT_PUBLIC_HEALTHALYST_PLATFORM_API_URL=https://healthalyst-platform-api-dev.onrender.com

# Public Cloudflare Turnstile site key used for registration.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Browser API origin. Use / for the Next.js /v1 transport proxy.
NEXT_PUBLIC_HEALTHALYST_PLATFORM_API_URL=/
# Fixed proxy target. Required only when the browser API origin is /.
HEALTHALYST_PLATFORM_API_URL=https://healthalyst-platform-api-dev.onrender.com
# For direct deployed calls, use an HTTPS API origin on the same site as the apps
# and omit HEALTHALYST_PLATFORM_API_URL. The backend must allow each app origin.

# Public Cloudflare Turnstile site key for organisation registration.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Local destination for HealthAlyst platform staff after sign-in.
NEXT_PUBLIC_HEALTHALYST_SUPER_ADMIN_APP_URL=http://localhost:3007

# Local HealthSchedule application, opened from the organisation's product list.
NEXT_PUBLIC_HEALTHALYST_HEALTH_SCHEDULE_APP_URL=http://localhost:3006

# HealthAlyst's NestJS Platform API. This value is server-only; browsers use
# the same-origin Next.js backend-for-frontend at /api/platform.
HEALTHALYST_PLATFORM_API_URL=https://healthalyst-platform-api-dev.onrender.com
HEALTHALYST_APP_ORIGIN=http://localhost:5173

# The backend-for-frontend keeps Platform API tokens in an encrypted server-side Redis session.
# Local Redis is provided by the backend repository's development compose file.
HEALTHALYST_PLATFORM_SESSION_REDIS_URL=redis://localhost:6379
# Generate a unique value for this app with: openssl rand -base64 32
# Keep this value stable across instances and deployments of this app.
HEALTHALYST_PLATFORM_SESSION_SECRET=

# Public Cloudflare Turnstile site key used for registration.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

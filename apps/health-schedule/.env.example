# Browser API origin. Use / for the Next.js /v1 transport proxy.
NEXT_PUBLIC_HEALTHALYST_PLATFORM_API_URL=/
# Fixed proxy target. Required only when the browser API origin is /.
# Use the same target as the organisation app, or its sign-in cannot be
# restored here.
HEALTHALYST_PLATFORM_API_URL=https://healthalyst-platform-api-dev.onrender.com
# Deployed: set NEXT_PUBLIC_HEALTHALYST_PLATFORM_API_URL=https://account.healthalystafrica.com
# and omit HEALTHALYST_PLATFORM_API_URL. Sign-in then refreshes through the hub's
# /v1, which every HealthAlyst app shares (see docs/authentication.md).

# Public address of the organisation hub.
NEXT_PUBLIC_HEALTHALYST_ORGANIZATION_APP_URL=http://localhost:3005

# HealthSchedule API address for the browser. Use /health-schedule-api for this
# app's proxy, which is needed because the API does not accept browser PATCH,
# PUT or DELETE requests from other origins.
NEXT_PUBLIC_HEALTHALYST_HEALTH_SCHEDULE_API_URL=/health-schedule-api
# Fixed proxy target. Required only when the address above is a proxy path.
HEALTHALYST_HEALTH_SCHEDULE_API_URL=https://healthalyst-healthschedule-api-dev.onrender.com

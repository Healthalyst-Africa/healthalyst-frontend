{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "healthalyst": {
      "source": {
        "source": "github",
        "repo": "Healthalyst-Africa/claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "healthalyst-sdlc@healthalyst": true,
    "security-guidance@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Read(/**/.env.*.local)",
      "Read(/**/.env.development)",
      "Read(/**/.env.production)",
      "Read(/**/.env.test)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format-edited-file.mjs\"",
            "timeout": 60,
            "statusMessage": "Formatting the edited file"
          }
        ]
      }
    ]
  }
}
